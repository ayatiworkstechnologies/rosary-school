# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# =========================================================
# NODE / NEXT.JS DEPENDENCIES
# =========================================================

/node_modules
/.pnp
.pnp.*

.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# =========================================================
# TESTING
# =========================================================

/coverage


# =========================================================
# NEXT.JS
# =========================================================

/.next/
/out/


# =========================================================
# PRODUCTION
# =========================================================

/build


# =========================================================
# PYTHON / FASTAPI
# =========================================================

# Python virtual environment
backend/venv/
backend/.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Python cache anywhere inside backend
backend/**/__pycache__/

# Python test/cache folders
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Python coverage
.coverage
htmlcov/


# =========================================================
# BACKEND RUNTIME FILES
# =========================================================

backend/uploads/
backend/storage/
backend/logs/

*.log


# =========================================================
# DATABASE / LOCAL FILES
# =========================================================

*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal
*.sqlite3-journal


# =========================================================
# ENVIRONMENT / SECRETS
# =========================================================

# Protects:
# .env
# .env.local
# .env.production
# backend/.env
# etc.
.env*

# Optional example env files may be committed
!.env.example
!backend/.env.example


# =========================================================
# MISC
# =========================================================

.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.pid
*.tmp
*.temp
*.swp
*.swo

# Local editor settings
.idea/
.vscode/

# Local agent/tool state
.agents/
.codex/

# Browser and end-to-end test artifacts
/test-results/
/playwright-report/
/blob-report/


# =========================================================
# DEBUG LOGS
# =========================================================

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# =========================================================
# VERCEL
# =========================================================

.vercel


# =========================================================
# TYPESCRIPT
# =========================================================

*.tsbuildinfo
next-env.d.ts
